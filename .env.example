# ============================================================
#  Local development environment for the QC-2 Sound Builder
#  Copy to .env:   cp .env.example .env
#  .env is git-ignored — never commit real secrets.
# ============================================================

# ---- Storage backend --------------------------------------
# "s3"  -> S3-compatible store (MinIO locally, Cloudflare R2 in prod)
# "gcs" -> Google Cloud Storage (the original deployment path)
STORAGE_BACKEND=s3

# ---- S3 / MinIO / R2 --------------------------------------
S3_BUCKET=sound-builder-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
# Leave S3_ENDPOINT unset to use the local MinIO container. To point local dev
# at your real Cloudflare R2 bucket instead, set it here:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ---- LLM (Google AI Studio key — no GCP project required) --
GEMINI_API_KEY=replace-with-your-ai-studio-key

# ---- UI login ---------------------------------------------
# Setting MOCK_PASSWORD uses the local secret fetcher (skips GCP Secret
# Manager) and becomes the dashboard login password.
MOCK_PASSWORD=changeme

# ---- Usage reporting to GSR's hosted dashboard -----------------
# Reports this project's own native Gemini usage (the 12-agent pipeline's
# per-agent calls) to GSR's hosted usage dashboard, where it shows up under
# a "product" workload alongside GSR's own review/eval usage. Opt-in: both
# must be set, or reporting is silently disabled (same convention as GSR's
# own EVALUATOR_SHARED_SECRET) — neither var is set by default even in
# production. Open-LLM-provider calls are never reported; GSR's ingest only
# accepts Gemini usage.
# GSR_USAGE_INGEST_URL=https://gsr-code-review.fly.dev/api/usage/ingest
# GSR_USAGE_INGEST_KEY=replace-with-the-shared-secret-GSR-issued

# ---- Server -----------------------------------------------
PORT=8080

# Note: mock vs. live is chosen by the startup scripts — ./run-mock.sh (canned
# data, no key) or ./run-live.sh (real Gemini). docker-compose sets MOCK_MODE
# from the script, so editing a MOCK_MODE value here has no effect.
